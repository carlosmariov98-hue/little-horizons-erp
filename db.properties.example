# Copy this file to "db.properties" (same folder) and fill in your own MySQL credentials.
# "db.properties" is ignored by Git so your password is never uploaded.
db.url=jdbc:mysql://localhost:3306/erp_little_horizons?sslMode=DISABLED&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota
db.user=your_mysql_user
db.password=your_mysql_password